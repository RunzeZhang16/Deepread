DEEPSEEK_API_KEY=

# 本地开发可抄到 .env.local。服务器上的文件名是 .env，由 docker compose 注入。
# 线上 READONLY 由 compose 固定为 1，写库只走周五的定时脚本。

# DB_PATH=data/deepread.db
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=you@163.com
# SMTP_PASS=授权码
# MAIL_TO=you@163.com

# 邮件和确认链接用的站点地址。公网走 80，不要带 :3000。
# 备案和证书完成后改成 https://你的域名
# SITE_URL=http://124.220.163.131

# 可选。设置后，每周备份会再 rsync 一份到这台机器以外的目录。
# BACKUP_RSYNC_DEST=user@backup-host:/var/backups/deepread
